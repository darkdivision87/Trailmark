{
  "name": "trailmark",
  "version": "0.7.0",
  "description": "A private desktop workspace for tasks, focus, activity, clipboard recall, and finding audio sources.",
  "main": "main/main.js",
  "scripts": {
    "start": "electron .",
    "rebuild": "electron-rebuild -f -w node-window-manager",
    "dist": "electron-builder",
    "dist:mac": "npm run rebuild && electron-builder --mac dmg --publish never",
    "test": "node --test tests/*.test.cjs && electron tests/smoke.cjs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.0.0",
    "electron-rebuild": "^3.2.9"
  },
  "dependencies": {
    "node-window-manager": "^2.2.4"
  },
  "build": {
    "files": [
      "main/**/*",
      "preload/**/*",
      "assets/**/*",
      "package.json",
      "renderer/**/*"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "npmRebuild": false,
    "productName": "Trailmark",
    "appId": "com.vextrin.trailmark",
    "mac": {
      "target": "dmg",
      "icon": "assets/trailmark-app.png",
      "category": "public.app-category.productivity"
    },
    "win": {
      "icon": "assets/trailmark.ico"
    },
    "directories": {
      "output": "dist/0.7.0"
    }
  }
}
